# Sign in to Amazon; the session is kept in the browser profile.
run:
    deno run -A --env-file=.env main.ts

# One-time Chromium download for Playwright.
install:
    deno run -A npm:playwright@^1.62.1 install chromium

# Unit tests.
test:
    deno test --allow-env

# Formatting, lint, and type check.
check:
    deno fmt --check
    deno lint
    deno check .

# Apply formatting.
fmt:
    deno fmt

# Walk the scraped pages in a browser, outlining each region.
tour:
    deno run -A --env-file=.env main.ts tour
