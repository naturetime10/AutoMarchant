# Sign in to Amazon; the session is kept in the browser profile.
run:
    deno run -A --env-file=.env main.ts

# One-time Chromium download for Playwright.
install:
    deno run -A npm:playwright@^1.62.1 install chromium

# Unit tests.
test:
    deno test --allow-env --allow-read --allow-write --allow-net --env-file=.env

# Formatting, lint, and type check.
check:
    deno fmt --check
    deno lint
    deno check .

# Apply formatting.
fmt:
    deno fmt

# Walk every department page by page, writing each product to output/market/discover.
# Options: --departments=books,electronics --pages=N --products=N --images=N --out=DIR --pause=MS --concurrency=N
discover *options:
    deno run -A --env-file=.env main.ts discover {{ options }}
