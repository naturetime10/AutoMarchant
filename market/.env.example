# Copy to .env — .env is gitignored. Secrets only; the settings are in
# config.toml.
AMAZON_EMAIL=you@example.com
AMAZON_PASSWORD=

# Optional: base32 secret from Amazon's authenticator-app 2FA setup.
# Leave blank to be prompted for the code on each sign-in.
AMAZON_TOTP_SECRET=

# Postgres holding the catalog. See the README for the one-time setup.
DATABASE_URL=postgresql://automerchant:password@localhost:5432/automerchant
# The database the tests write to; they are skipped when it is unreachable.
TEST_DATABASE_URL=postgresql://automerchant:password@localhost:5432/automerchant_test
